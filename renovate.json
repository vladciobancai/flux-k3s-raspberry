{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "separateMajorMinor": true,
  "automerge": true,
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "labels": [
        "production"
      ]
    },
    {
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    }
  ]
}
